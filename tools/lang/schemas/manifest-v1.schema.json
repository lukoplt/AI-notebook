{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ainotebook:lang-detector-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "modelId",
    "artifactPath",
    "artifactSha256",
    "createdAt",
    "corpus",
    "negativeLanguages",
    "environment",
    "split",
    "caps",
    "augmentation",
    "counts",
    "exclusions",
    "minimumSupport",
    "calibration",
    "support",
    "metrics",
    "documentMetrics",
    "attribution"
  ],
  "properties": {
    "contract": {
      "const": "lang-detector-manifest"
    },
    "version": {
      "const": 1
    },
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "artifactPath": {
      "type": "string"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "corpus": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/corpus"
      },
      "minItems": 1
    },
    "negativeLanguages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}$"
      },
      "minItems": 1
    },
    "snapshotSkew": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingFromBase",
        "cc0DetailMismatch",
        "excludedIdsSha256",
        "sampleIds"
      ],
      "properties": {
        "missingFromBase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cc0DetailMismatch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excludedIdsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sampleIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "maxItems": 20
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exporterGitCommit",
        "commandArguments",
        "pythonVersion",
        "dependencies",
        "normalizationTablesVersion",
        "unicodeFiles"
      ],
      "properties": {
        "exporterGitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "commandArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "pythonVersion": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "minItems": 0
        },
        "normalizationTablesVersion": {
          "const": "ucd-15.1.0-default-full-v1"
        },
        "unicodeFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "seed",
        "splitBp",
        "maxComponentMembers",
        "oversizedComponents"
      ],
      "properties": {
        "algorithm": {
          "const": "translation-components-sha256-v1"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "splitBp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "train",
            "validation",
            "test"
          ],
          "properties": {
            "train": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9998
            },
            "validation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9998
            },
            "test": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9998
            }
          }
        },
        "maxComponentMembers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "oversizedComponents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groupId",
              "memberCount",
              "blocks"
            ],
            "properties": {
              "groupId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "memberCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "groupId",
                    "memberCount"
                  ],
                  "properties": {
                    "groupId": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "memberCount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "caps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "split",
          "language",
          "maxOriginalRecords"
        ],
        "properties": {
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "language": {
            "type": "string"
          },
          "maxOriginalRecords": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1
    },
    "augmentation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/augmentation"
      },
      "minItems": 1
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "split",
          "language",
          "bucketStart",
          "originals",
          "augmented",
          "originalGroups"
        ],
        "properties": {
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "language": {
            "type": "string"
          },
          "bucketStart": {
            "enum": [
              0,
              12,
              32,
              80,
              200
            ]
          },
          "originals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "augmented": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "originalGroups": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "split",
          "language",
          "reason",
          "count"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "language": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 0
    },
    "minimumSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupsPerTarget",
        "groupsPerNegativeLanguage",
        "acceptedTotal",
        "acceptedTrueCs",
        "acceptedTrueSk"
      ],
      "properties": {
        "groupsPerTarget": {
          "const": 200
        },
        "groupsPerNegativeLanguage": {
          "const": 200
        },
        "acceptedTotal": {
          "const": 1000
        },
        "acceptedTrueCs": {
          "const": 100
        },
        "acceptedTrueSk": {
          "const": 100
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "candidates",
        "tieBreak",
        "disabledBuckets"
      ],
      "properties": {
        "algorithm": {
          "const": "grid-max-accepted-v1"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bucketStart",
              "minWinningScores",
              "minMargins",
              "minKnownCoverageBp"
            ],
            "properties": {
              "bucketStart": {
                "enum": [
                  12,
                  32,
                  80,
                  200
                ]
              },
              "minWinningScores": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -7000000,
                  "maximum": 0
                },
                "minItems": 1
              },
              "minMargins": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7000000
                },
                "minItems": 1
              },
              "minKnownCoverageBp": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "minItems": 1
              }
            }
          },
          "minItems": 4,
          "maxItems": 4
        },
        "tieBreak": {
          "const": [
            "minWinningScoreDescending",
            "minMarginDescending",
            "minKnownCoverageBpDescending"
          ]
        },
        "disabledBuckets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bucketStart",
              "reason"
            ],
            "properties": {
              "bucketStart": {
                "enum": [
                  12,
                  32,
                  80,
                  200
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "support": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/support"
      },
      "minItems": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      },
      "minItems": 1
    },
    "documentMetrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "goldLabel",
          "predictedLabel",
          "count"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "goldLabel": {
            "enum": [
              "cs",
              "de",
              "en",
              "sk",
              "mixed",
              "und"
            ]
          },
          "predictedLabel": {
            "enum": [
              "cs",
              "de",
              "en",
              "sk",
              "mixed",
              "und"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 0
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIds",
        "licenseIds",
        "attributionPath",
        "attributionSha256",
        "noticePath",
        "noticeSha256"
      ],
      "properties": {
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "minItems": 0
        },
        "licenseIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "attributionPath": {
          "type": "string"
        },
        "attributionSha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "noticePath": {
          "type": "string"
        },
        "noticeSha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "url",
        "snapshotDate",
        "sha256",
        "formatVersion",
        "records"
      ],
      "properties": {
        "role": {
          "enum": [
            "sentences",
            "links",
            "attribution",
            "ownedExamples",
            "unicodeData",
            "normalizationTest"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "snapshotDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "formatVersion": {
          "type": "string"
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "files",
        "licenseIds",
        "licenseSelectionPolicy",
        "languageSelectionPolicy",
        "deduplicationPolicy",
        "translationGroupPolicy",
        "originalRecords",
        "languageMappings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        },
        "licenseIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "licenseSelectionPolicy": {
          "type": "string"
        },
        "languageSelectionPolicy": {
          "type": "string"
        },
        "deduplicationPolicy": {
          "type": "string"
        },
        "translationGroupPolicy": {
          "type": "string"
        },
        "originalRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "languageMappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceLanguage",
              "detectorLanguage"
            ],
            "properties": {
              "sourceLanguage": {
                "type": "string",
                "minLength": 1
              },
              "detectorLanguage": {
                "type": "string",
                "pattern": "^[a-z]{2,3}$"
              }
            }
          }
        }
      }
    },
    "augmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "splits",
        "lengths",
        "inputCount",
        "outputCount"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "none-v1",
            "scalar-prefix-v1",
            "strip-marks-v1",
            "concat-v1"
          ]
        },
        "splits": {
          "type": "array",
          "items": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "minItems": 1,
          "maxItems": 3
        },
        "lengths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000000
          },
          "minItems": 0
        },
        "inputCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split",
        "bucketStart",
        "language",
        "originalGroups",
        "evaluated",
        "accepted"
      ],
      "properties": {
        "split": {
          "enum": [
            "validation",
            "test"
          ]
        },
        "bucketStart": {
          "enum": [
            12,
            32,
            80,
            200
          ]
        },
        "language": {
          "type": "string"
        },
        "originalGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split",
        "bucketStart",
        "language",
        "name",
        "numerator",
        "denominator",
        "rateBp"
      ],
      "properties": {
        "split": {
          "enum": [
            "validation",
            "test"
          ]
        },
        "bucketStart": {
          "enum": [
            0,
            12,
            32,
            80,
            200
          ]
        },
        "language": {
          "type": "string"
        },
        "name": {
          "enum": [
            "acceptedError",
            "csSkConfusion",
            "foreignAcceptance",
            "acceptanceCoverage"
          ]
        },
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rateBp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
