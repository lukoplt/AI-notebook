<?xml version="1.0" encoding="utf-8"?>
<!--
  Right panel › Sources (spec §2.3): the former SourceListPage, condensed. Folder row = icon, name,
  one summary line ("Files: 1 204 · Errors: 3", details in the tooltip) and a "…" menu (Scan,
  Verify all, Rules…, Watch ✓, Remove). "+" adds file / folder / URL / text; the panel "…" holds
  bulk mode and the tag filter. Drop files or folders anywhere on the panel.
-->
<UserControl
    x:Class="AINotebook.App.Panels.SourcesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AINotebook.App.ViewModels"
    xmlns:models="using:AINotebook.Core.Models"
    xmlns:views="using:AINotebook.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="FolderRowTemplate" x:DataType="vm:FolderRowViewModel">
            <Grid Padding="0,6" ColumnSpacing="{StaticResource Space4}" Tag="{x:Bind}"
                  RightTapped="OnFolderRowRightTapped" ToolTipService.ToolTip="{x:Bind DetailText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Grouped Sources: expand / collapse this folder's members (collapsed by default) -->
                <Button Click="OnToggleFolder" Tag="{x:Bind}" Style="{StaticResource IconButtonStyle}" Padding="4"
                        AutomationProperties.Name="{x:Bind ToggleLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ToggleLabel, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontFamily="{StaticResource FontIcons}"
                              FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource Text3Brush}" />
                </Button>
                <FontIcon Grid.Column="1" Glyph="{StaticResource IconFolder}" Style="{StaticResource RowIcon}" />
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                               Foreground="{ThemeResource Text1Brush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind SummaryText}" Style="{StaticResource SecondaryCaption}" TextTrimming="CharacterEllipsis" />
                    <!-- Scan now / Verify all: "Checking…" at once, then a transient outcome caption -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}"
                                Visibility="{x:Bind IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ProgressRing Width="{StaticResource Space12}" Height="{StaticResource Space12}"
                                      IsActive="{x:Bind IsChecking, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind CheckingText}" Style="{StaticResource SecondaryCaption}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ScanCaption, Mode=OneWay}" Style="{StaticResource SecondaryCaption}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ScanCaption, Mode=OneWay, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{x:Bind ErrorText}" Style="{StaticResource TextCaption}" Foreground="{ThemeResource DangerBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ErrorText, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="OnFolderMore"
                        AutomationProperties.Name="{x:Bind MoreLabel}" ToolTipService.ToolTip="{x:Bind MoreLabel}">
                    <FontIcon Glyph="{StaticResource IconMore}" Style="{StaticResource RowIcon}" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SourceRowTemplate" x:DataType="vm:SourceItem">
            <Grid Padding="0,4" ColumnSpacing="{StaticResource Space8}" Margin="{x:Bind IndentMargin}"
                  Tag="{x:Bind}" RightTapped="OnSourceRowRightTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- B6: bulk checkbox -->
                <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                          AutomationProperties.Name="{x:Bind Title}"
                          Visibility="{x:Bind IsBulkMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <FontIcon Grid.Column="1" Glyph="{x:Bind KindGlyph}" Style="{StaticResource RowIcon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="2" Spacing="2">
                    <!-- Folder members show their relative path; loose sources their title -->
                    <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource TextBody}" Foreground="{ThemeResource Text1Brush}"
                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" />
                        <Border Background="{ThemeResource Surface2Brush}" CornerRadius="{StaticResource RadiusPill}" Padding="6,0"
                                Visibility="{x:Bind AvailabilityText, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{x:Bind AvailabilityText}" Style="{StaticResource TextCaption}" Foreground="{ThemeResource WarningBrush}" />
                        </Border>
                        <Border Background="{ThemeResource Surface2Brush}" CornerRadius="{StaticResource RadiusPill}" Padding="6,0"
                                AutomationProperties.Name="{x:Bind LanguageLabel}"
                                ToolTipService.ToolTip="{x:Bind LanguageLabel}"
                                Visibility="{x:Bind LanguageBadge, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{x:Bind LanguageBadge}" Style="{StaticResource TextCaption}" Foreground="{ThemeResource Text2Brush}" />
                        </Border>
                        <ProgressRing Width="{StaticResource Space12}" Height="{StaticResource Space12}"
                                      IsActive="{x:Bind IsSummarizing, Mode=OneWay}"
                                      Visibility="{x:Bind IsSummarizing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressRing Width="{StaticResource Space12}" Height="{StaticResource Space12}"
                                      IsActive="{x:Bind IsRefreshing, Mode=OneWay}"
                                      Visibility="{x:Bind IsRefreshing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource QuietButtonStyle}" FontSize="{StaticResource FontSizeCaption}" Padding="4,0"
                                Content="{x:Bind RetryText}" Tag="{x:Bind}" Click="OnRetrySourceRow"
                                Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource TextCaption}" Foreground="{ThemeResource Text2Brush}"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind Summary, Mode=OneWay, Converter={StaticResource NullToCollapsed}}" />
                    <!-- B8: tags for this source -->
                    <ItemsControl ItemsSource="{x:Bind Tags, Mode=OneWay}"
                                  Visibility="{x:Bind Tags.Count, Mode=OneWay, Converter={StaticResource CountToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                                <Border Background="{ThemeResource Surface2Brush}" CornerRadius="{StaticResource RadiusPill}" Padding="6,0">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource TextCaption}" Foreground="{ThemeResource Text2Brush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="OnSourceMore"
                        VerticalAlignment="Top" AutomationProperties.Name="{x:Bind Title}">
                    <FontIcon Glyph="{StaticResource IconMore}" Style="{StaticResource RowIcon}" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FolderFooterTemplate" x:DataType="vm:FolderFooterRow">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" Padding="28,2,0,8">
                <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="{StaticResource Space12}" Height="{StaticResource Space12}"
                              Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{x:Bind CountText, Mode=OneWay}" Style="{StaticResource SecondaryCaption}" VerticalAlignment="Center" />
                <Button Content="{x:Bind LoadMoreLabel}" Tag="{x:Bind}" Click="OnLoadMoreMembers" Style="{StaticResource QuietButtonStyle}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Visibility="{x:Bind HasMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{x:Bind NoFilesText}" Style="{StaticResource SecondaryCaption}" VerticalAlignment="Center"
                           Visibility="{x:Bind IsEmptyFolder, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <views:SourceRowTemplateSelector x:Key="SourceRowSelector"
                                         FolderTemplate="{StaticResource FolderRowTemplate}"
                                         SourceTemplate="{StaticResource SourceRowTemplate}"
                                         FooterTemplate="{StaticResource FolderFooterTemplate}" />
    </UserControl.Resources>

    <Grid Padding="12,0,12,12" RowSpacing="{StaticResource Space8}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: indexing status strip (this notebook) · + · … -->
        <Grid ColumnSpacing="{StaticResource Space4}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Spec 2026-10-10 §4: icon + text (+ one action), a thin progress bar while working, unreadable-file count -->
            <StackPanel x:Name="IndexingStrip" Grid.ColumnSpan="2" Spacing="{StaticResource Space4}" VerticalAlignment="Center"
                        Padding="0,4" Visibility="Collapsed">
                <Grid ColumnSpacing="{StaticResource Space8}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="IndexingIcon" Glyph="{StaticResource IconIndexing}" FontFamily="{StaticResource FontIcons}"
                              FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource Text3Brush}"
                              VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock x:Name="IndexingText" Grid.Column="1" Style="{StaticResource TextCaption}"
                               Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" MaxLines="3"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <ProgressBar x:Name="IndexingProgress" Maximum="1" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <TextBlock x:Name="IndexingSecondaryText" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                    <!-- ingestion-retry-cap-v1 §5: failed files are not retried automatically after three attempts -->
                    <Button x:Name="IndexingRetryAllButton" Style="{StaticResource QuietButtonStyle}" FontSize="{StaticResource FontSizeCaption}"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="OnRetryAllFailed" />
                </StackPanel>
                <Button x:Name="IndexingActionButton" Style="{StaticResource QuietButtonStyle}" FontSize="{StaticResource FontSizeCaption}"
                        HorizontalAlignment="Left" Visibility="Collapsed" Click="OnIndexingAction" />
            </StackPanel>
            <Button x:Name="AddButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top">
                <FontIcon Glyph="{StaticResource IconAdd}" Style="{StaticResource RowIcon}" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="AddFileItem" Click="OnAddFile">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="{StaticResource IconAddFile}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <!-- WP6: add a persisted, watched folder -->
                        <MenuFlyoutItem x:Name="AddFolderItem" Click="OnAddFolder">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="{StaticResource IconAddFolder}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="AddUrlItem" Click="OnAddUrl">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="{StaticResource IconAddUrl}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="AddTextItem" Click="OnAddText">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="{StaticResource IconAddText}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="PanelMoreButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top"
                    Click="OnPanelMore">
                <FontIcon Glyph="{StaticResource IconMore}" Style="{StaticResource RowIcon}" />
            </Button>
        </Grid>

        <!-- Active tag filter -->
        <Button x:Name="TagFilterChip" Grid.Row="1" Style="{StaticResource ChipButtonStyle}" Click="OnClearTagFilter"
                HorizontalAlignment="Left" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                <FontIcon Glyph="{StaticResource IconTag}" FontFamily="{StaticResource FontIcons}" FontSize="{StaticResource FontSizeCaption}" />
                <TextBlock x:Name="TagFilterText" />
                <FontIcon Glyph="{StaticResource IconClose}" FontFamily="{StaticResource FontIcons}" FontSize="{StaticResource FontSizeCaption}" />
            </StackPanel>
        </Button>

        <!-- B6: bulk action bar -->
        <Grid Grid.Row="2" ColumnSpacing="{StaticResource Space8}"
              Visibility="{x:Bind ViewModel.IsBulkMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BulkSelectedLabel" Style="{StaticResource SecondaryCaption}" VerticalAlignment="Center" />
            <Button x:Name="BulkSummarizeButton" Grid.Column="1" Style="{StaticResource QuietButtonStyle}"
                    Command="{x:Bind ViewModel.BulkSummarizeCommand}" />
            <Button x:Name="BulkDeleteButton" Grid.Column="2" Style="{StaticResource QuietButtonStyle}"
                    Foreground="{ThemeResource DangerBrush}" Click="OnBulkDelete" />
            <Button x:Name="BulkDoneButton" Grid.Column="3" Style="{StaticResource QuietButtonStyle}"
                    Command="{x:Bind ViewModel.ToggleBulkModeCommand}" />
        </Grid>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="3" Spacing="{StaticResource Space12}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="{StaticResource IconFolder}" FontFamily="{StaticResource FontIcons}"
                      FontSize="{StaticResource Space32}" Foreground="{ThemeResource Text3Brush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource TextBody}" Foreground="{ThemeResource Text2Brush}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="EmptyAddFolderButton" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"
                    Click="OnAddFolder" />
        </StackPanel>

        <!-- WP6 folders (expandable, members collapsed by default) followed by loose sources -->
        <ListView x:Name="SourceList" Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource SourceRowSelector}"
                  ItemContainerStyle="{StaticResource FlatListItemStyle}"
                  SelectionMode="None">
            <ListView.Resources>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource Surface2}" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource Border}" />
            </ListView.Resources>
        </ListView>

        <!-- Muted error row (localized folder errors, no exception dumps) -->
        <Grid Grid.Row="4" ColumnSpacing="{StaticResource Space8}"
              Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="{StaticResource IconWarning}" Style="{StaticResource RowIcon}" Foreground="{ThemeResource WarningBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource TextCaption}"
                       Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" />
            <Button x:Name="DismissErrorButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnDismissError">
                <FontIcon Glyph="{StaticResource IconClose}" Style="{StaticResource RowIcon}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
