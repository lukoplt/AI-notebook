<?xml version="1.0" encoding="utf-8"?>
<!--
  Right panel › Context (spec §2.3): the memory-only WP8 context preview — the next message's
  draft or a sent turn's retained context — as collapsible sections; token figures stay small
  and grey inside the section labels. The request text is shown unmodified (monospace).
-->
<UserControl
    x:Class="AINotebook.App.Panels.ContextPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AINotebook.App.ViewModels">
    <Grid Padding="12,0,12,12" RowSpacing="{StaticResource Space8}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="{StaticResource Space8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="KindText" Style="{StaticResource PanelHeader}" VerticalAlignment="Center"
                       Text="{x:Bind KindLabel(ViewModel.ShowingDraftPreview, ViewModel.ContextPreview), Mode=OneWay}" />
            <ProgressRing Grid.Column="1" Width="{StaticResource Space16}" Height="{StaticResource Space16}"
                          IsActive="{x:Bind ViewModel.PreparingContext, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.PreparingContext, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <!-- Recalculate / show the next message: prepares the current draft again -->
            <Button x:Name="RecalculateButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                    Command="{x:Bind ViewModel.PrepareContextCommand}">
                <FontIcon Glyph="{StaticResource IconRegenerate}" Style="{StaticResource RowIcon}" />
            </Button>
        </Grid>

        <HyperlinkButton x:Name="BackToDraftButton" Grid.Row="1" Padding="0" Foreground="{ThemeResource FocusBrush}"
                         Command="{x:Bind ViewModel.PrepareContextCommand}"
                         Visibility="{x:Bind SentVisibility(ViewModel.ShowingDraftPreview, ViewModel.ContextPreview), Mode=OneWay}" />

        <!-- Assumed context window (provider-listing-limits-v1 §5) → Settings › Models & limits -->
        <HyperlinkButton x:Name="SetContextSizeButton" Grid.Row="2" Padding="0" Foreground="{ThemeResource FocusBrush}"
                         Visibility="{x:Bind AssumedVisibility(ViewModel.ContextPreview), Mode=OneWay}" />

        <TextBlock x:Name="HintText" Grid.Row="3" Style="{StaticResource TextBody}" Foreground="{ThemeResource Text2Brush}"
                   TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                   Visibility="{x:Bind HintVisibility(ViewModel.ContextPreview), Mode=OneWay}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.ContextPreview.Rows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContextPreviewRow">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4"
                                  Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource BorderBrush}">
                            <Expander.Header>
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource TextCaption}"
                                           Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <TextBlock Text="{x:Bind Text}" Style="{StaticResource TextMono}" Foreground="{ThemeResource Text1Brush}"
                                       FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
