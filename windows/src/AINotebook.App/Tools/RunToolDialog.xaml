<?xml version="1.0" encoding="utf-8"?>
<!--
  "+ › Run tool" (spec §2.7): the former Transformations tab as a dialog — template, scope, source,
  prompt preview, run; the result is saved as a note that can be opened as a document. Templates
  are edited in Settings › Tools; run history lives in the Notes panel.
-->
<ContentDialog
    x:Class="AINotebook.App.Tools.RunToolDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="None">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>
    <Grid RowSpacing="{StaticResource Space12}" MinWidth="{StaticResource SizeOnboardingCardMax}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Template -->
        <StackPanel Spacing="{StaticResource Space4}">
            <Grid>
                <TextBlock x:Name="PickerLabel" Style="{StaticResource SecondaryCaption}" />
                <HyperlinkButton x:Name="PreviewBtn" HorizontalAlignment="Right" Padding="0" Click="OnPreview"
                                 Foreground="{ThemeResource FocusBrush}" />
            </Grid>
            <ComboBox x:Name="TemplateCombo" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Transformations, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedTransformation, Mode=TwoWay}"
                      DisplayMemberPath="Name" />
            <TextBlock Text="{x:Bind ViewModel.SelectedTransformationDescription, Mode=OneWay}" Style="{StaticResource TextCaption}"
                       Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Scope -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource Space4}">
            <ComboBox x:Name="ScopeSeg" MinWidth="{StaticResource SizeSidebarMin}" SelectionChanged="OnScopeChanged">
                <ComboBoxItem x:Name="ScopeSource" />
                <ComboBoxItem x:Name="ScopeNotebook" />
                <ComboBoxItem x:Name="ScopeAll" />
            </ComboBox>
            <TextBlock x:Name="ScopeHint" Style="{StaticResource SecondaryCaption}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Source + Run -->
        <Grid Grid.Row="2" ColumnSpacing="{StaticResource Space8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceCombo" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}"
                      DisplayMemberPath="Title" />
            <Button x:Name="RunBtn" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.RunCommand}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- Error -->
        <Grid Grid.Row="3" ColumnSpacing="{StaticResource Space8}"
              Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="{StaticResource IconWarning}" Style="{StaticResource RowIcon}" Foreground="{ThemeResource WarningBrush}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource TextCaption}"
                       Foreground="{ThemeResource Text2Brush}" TextWrapping="Wrap" />
        </Grid>

        <!-- Running / result (managed in code-behind) -->
        <Grid Grid.Row="4" x:Name="ContentHost" MinHeight="{StaticResource SizeTopBar}" />
    </Grid>
</ContentDialog>
