<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens v1 for the WinUI app. Values = Tests/fixtures/contracts/ui-tokens-v1.json
  (human table: docs/design/tokens-v1.md); UITokensTests in AINotebook.Core.Tests parses
  this file and compares every value with the fixture. Views use these keys only:
  colours via {ThemeResource Text1Brush}, metrics via {StaticResource RadiusLg}, glyphs via
  {StaticResource IconNewChat}. No hard-coded colours or sizes in views.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
