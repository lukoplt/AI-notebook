    <!-- Fonts (system only) -->
    <FontFamily x:Key="FontText">Segoe UI Variable</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons</FontFamily>

    <!-- Type ramp (Windows line heights) -->
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="LineHeightTitle">28</x:Double>
    <x:Double x:Key="FontSizeHeadline">15</x:Double>
    <x:Double x:Key="LineHeightHeadline">22</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="LineHeightBody">20</x:Double>
    <x:Double x:Key="FontSizeMessage">15</x:Double>
    <x:Double x:Key="LineHeightMessage">24</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="LineHeightCaption">16</x:Double>
    <x:Double x:Key="FontSizeMono">13</x:Double>
    <x:Double x:Key="LineHeightMono">20</x:Double>

    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightTitle}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextHeadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightHeadline}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightBody}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="TextMessage" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMessage}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightMessage}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightCaption}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeightMono}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

