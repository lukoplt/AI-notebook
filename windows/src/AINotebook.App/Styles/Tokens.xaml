            <SolidColorBrush x:Key="WarningBrush" Color="#B26A00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="Bg">#1E1E1E</Color>
            <Color x:Key="BgSidebar">#181818</Color>
