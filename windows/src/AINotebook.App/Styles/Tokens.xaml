            <Color x:Key="Text3">#8E8E93</Color>
            <Color x:Key="Accent">#0D0D0D</Color>
            <Color x:Key="OnAccent">#FFFFFF</Color>
            <Color x:Key="Focus">#2F6FEB</Color>
            <Color x:Key="Success">#1F8A4C</Color>
            <Color x:Key="Warning">#B26A00</Color>
            <Color x:Key="Danger">#C42B1C</Color>
            <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF" />
