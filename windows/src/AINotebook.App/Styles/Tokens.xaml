        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">  <!-- Default = Dark (WinUI fallback, also used by high contrast) -->
            <Color x:Key="Bg">#1E1E1E</Color>
            <Color x:Key="BgSidebar">#181818</Color>
