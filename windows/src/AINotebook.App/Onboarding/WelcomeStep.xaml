<UserControl
    x:Class="AINotebook.App.Onboarding.WelcomeStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space16}">
        <FontIcon Glyph="{StaticResource IconNotebook}" FontFamily="{StaticResource FontIcons}" FontSize="{StaticResource Space32}"
                  HorizontalAlignment="Center" Foreground="{ThemeResource Text1Brush}" />
        <TextBlock x:Name="TitleText" Style="{StaticResource TextTitle}" Foreground="{ThemeResource Text1Brush}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Style="{StaticResource TextBody}" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{ThemeResource Text2Brush}" />
        <Button x:Name="ContinueButton" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                Click="OnContinue">
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="Enter" />
            </Button.KeyboardAccelerators>
        </Button>
    </StackPanel>
</UserControl>
