<UserControl
    x:Class="AINotebook.App.Onboarding.PullModelsStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">
    <StackPanel Spacing="{StaticResource Space16}">
        <TextBlock x:Name="TitleText" Style="{StaticResource TextTitle}" Foreground="{ThemeResource Text1Brush}" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Style="{StaticResource TextBody}" TextWrapping="Wrap" Foreground="{ThemeResource Text2Brush}" />

        <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock x:Name="ChatTitle" Style="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{ThemeResource Text1Brush}" />
            <ProgressBar x:Name="ChatBar" Minimum="0" Maximum="1" Foreground="{ThemeResource AccentBrush}" />
            <TextBlock x:Name="ChatStatus" Style="{StaticResource SecondaryCaption}" />
        </StackPanel>

        <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock x:Name="EmbedTitle" Style="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{ThemeResource Text1Brush}" />
            <ProgressBar x:Name="EmbedBar" Minimum="0" Maximum="1" Foreground="{ThemeResource AccentBrush}" />
            <TextBlock x:Name="EmbedStatus" Style="{StaticResource SecondaryCaption}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource TextBody}"
                   Foreground="{ThemeResource DangerBrush}" />
    </StackPanel>
</UserControl>
