<UserControl
    x:Class="AINotebook.App.Onboarding.DetectOllamaStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource Space16}">
        <FontIcon x:Name="StatusIcon" FontFamily="{StaticResource FontIcons}" FontSize="{StaticResource Space32}"
                  HorizontalAlignment="Center" Glyph="&#xE9A9;" Foreground="{ThemeResource Text2Brush}" />
        <TextBlock x:Name="TitleText" Style="{StaticResource TextTitle}" Foreground="{ThemeResource Text1Brush}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" Style="{StaticResource TextBody}" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{ThemeResource Text2Brush}" />

        <StackPanel x:Name="FoundPanel" Spacing="{StaticResource Space12}" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="FoundText" Style="{StaticResource TextBody}" HorizontalAlignment="Center"
                       Foreground="{ThemeResource SuccessBrush}" />
            <Button x:Name="ContinueButton" HorizontalAlignment="Center"
                    Style="{StaticResource PrimaryButtonStyle}" Click="OnContinue">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" />
                </Button.KeyboardAccelerators>
            </Button>
        </StackPanel>

        <StackPanel x:Name="WaitingPanel" Spacing="{StaticResource Space12}" HorizontalAlignment="Center">
            <ProgressRing IsActive="True" Width="{StaticResource Space24}" Height="{StaticResource Space24}" HorizontalAlignment="Center" />
            <TextBlock x:Name="WaitingText" Style="{StaticResource SecondaryCaption}" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="DownloadButton" HorizontalAlignment="Center" Style="{StaticResource QuietButtonStyle}" Click="OnOpenDownload" />
        </StackPanel>
    </StackPanel>
</UserControl>
